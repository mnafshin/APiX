{
  "name": "apix",
  "displayName": "APiX - API Debugger",
  "description": "Intercept, inspect, and debug HTTP/HTTPS traffic directly in VS Code",
  "version": "0.1.0",
  "publisher": "apix",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mnafshin/apix"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Debuggers",
    "Other"
  ],
  "keywords": [
    "http",
    "proxy",
    "debugger",
    "intercept",
    "mitm"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "apix.startEngine",
        "title": "APiX: Start Engine",
        "icon": "$(play)"
      },
      {
        "command": "apix.stopEngine",
        "title": "APiX: Stop Engine",
        "icon": "$(stop)"
      },
      {
        "command": "apix.clearHistory",
        "title": "APiX: Clear Traffic History",
        "icon": "$(clear-all)"
      },
      {
        "command": "apix.addBreakpoint",
        "title": "APiX: Add URL Breakpoint",
        "icon": "$(add)"
      },
      {
        "command": "apix.deleteBreakpoint",
        "title": "APiX: Delete Breakpoint",
        "icon": "$(trash)"
      },
      {
        "command": "apix.toggleBreakpoint",
        "title": "APiX: Enable/Disable Breakpoint",
        "icon": "$(circle-outline)"
      },
      {
        "command": "apix.replayRequest",
        "title": "APiX: Replay Request",
        "icon": "$(refresh)"
      },
      {
        "command": "apix.openTrafficPanel",
        "title": "APiX: Open Traffic Inspector",
        "icon": "$(globe)"
      },
      {
        "command": "apix.refreshTraffic",
        "title": "APiX: Refresh Traffic",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "apix",
          "title": "APiX",
          "icon": "resources/icons/apix.svg"
        }
      ]
    },
    "views": {
      "apix": [
        {
          "id": "apix.trafficView",
          "name": "Traffic",
          "type": "tree",
          "icon": "$(globe)",
          "contextualTitle": "APiX Traffic"
        },
        {
          "id": "apix.breakpointsView",
          "name": "Breakpoints",
          "type": "tree",
          "icon": "$(debug-breakpoint)",
          "contextualTitle": "APiX Breakpoints"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "apix.startEngine",
          "when": "view == apix.trafficView",
          "group": "navigation"
        },
        {
          "command": "apix.stopEngine",
          "when": "view == apix.trafficView",
          "group": "navigation"
        },
        {
          "command": "apix.clearHistory",
          "when": "view == apix.trafficView",
          "group": "navigation"
        },
        {
          "command": "apix.addBreakpoint",
          "when": "view == apix.breakpointsView",
          "group": "navigation"
        },
        {
          "command": "apix.refreshTraffic",
          "when": "view == apix.trafficView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "apix.replayRequest",
          "when": "view == apix.trafficView && viewItem == httpTransaction",
          "group": "inline"
        },
        {
          "command": "apix.deleteBreakpoint",
          "when": "view == apix.breakpointsView && viewItem == breakpoint",
          "group": "inline"
        },
        {
          "command": "apix.toggleBreakpoint",
          "when": "view == apix.breakpointsView && viewItem == breakpoint",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "APiX",
      "properties": {
        "apix.engine.host": {
          "type": "string",
          "default": "localhost",
          "description": "Hostname of the APiX engine gRPC server."
        },
        "apix.engine.grpcPort": {
          "type": "number",
          "default": 9090,
          "description": "gRPC port of the APiX engine."
        },
        "apix.engine.proxyPort": {
          "type": "number",
          "default": 8080,
          "description": "HTTP proxy port of the APiX engine."
        },
        "apix.engine.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Automatically start the engine when VS Code opens."
        },
        "apix.engine.tlsEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Use TLS for the gRPC connection (required for vscode.dev)."
        },
        "apix.engine.authToken": {
          "type": "string",
          "default": "",
          "description": "Optional bearer token for authenticating with a remote engine."
        },
        "apix.engine.binaryPath": {
          "type": "string",
          "default": "",
          "description": "Path to the apix-engine binary. Leave empty to use the bundled binary."
        },
        "apix.traffic.maxItems": {
          "type": "number",
          "default": 500,
          "description": "Maximum number of traffic items to display in the Traffic view."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "lint": "eslint src --ext ts",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.10.0",
    "@grpc/proto-loader": "^0.7.10",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vscode/vsce": "^2.22.0",
    "eslint": "^8.0.0",
    "typescript": "^5.3.0"
  }
}
